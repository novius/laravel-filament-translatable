{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "novius/laravel-filament-translatable",
    "description": "A Laravel Filament package for translatable fields",
    "keywords": [
        "laravel",
        "filament",
        "translatable"
    ],
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/novius/laravel-filament-translatable",
    "support": {
        "issues": "https://github.com/novius/laravel-filament-translatable/issues",
        "source": "https://github.com/novius/laravel-filament-translatable"
    },
    "authors": [
        {
            "name": "Novius Agency",
            "email": "team-developpeurs@novius.com",
            "homepage": "https://www.novius.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "filament/filament": "^4.0 | ^5.0",
        "novius/laravel-translatable": "^2.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.1",
        "laravel/pint": "^1.21",
        "novius/laravel-publishable": "^3.1",
        "orchestra/testbench": "^9.0 | ^10.1 | ^11.0",
        "pestphp/pest": "^3.7 || ^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Novius\\LaravelFilamentTranslatable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Novius\\LaravelFilamentTranslatable\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit 1G"
        ],
        "test:unit": [
            "@php vendor/bin/pest"
        ],
        "test": [
            "@lint:check",
            "@analyse",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Novius\\LaravelFilamentTranslatable\\LaravelFilamentTranslatableServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
